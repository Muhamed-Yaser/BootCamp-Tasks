<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="draw2dBean"
          class="com.example.beanscope.BeansLifecycle_Task5.Draw2d"/>

    <bean id="draw3dBean"
          class="com.example.beanscope.BeansLifecycle_Task5.Draw3d"/>

    <bean id="circleBean"
          class="com.example.beanscope.BeansLifecycle_Task5.Circle"
          scope="singleton">

        <constructor-arg ref="draw2dBean"/>

    </bean>

    <bean id="squareBean"
          class="com.example.beanscope.BeansLifecycle_Task5.Square"
          scope="prototype">

        <property name="draw3d"
                  ref="draw3dBean"/>

    </bean>

    <bean id="databaseBean"
          class="com.example.beanscope.BeansLifecycle_Task5.DatabaseOperations"
          init-method="connectToDatabase"
          destroy-method="disconnectFromDatabase"/>

</beans>